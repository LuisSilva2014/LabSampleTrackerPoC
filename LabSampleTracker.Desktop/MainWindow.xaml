<Window x:Class="LabSampleTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LabSampleTracker.Desktop.Converters"
        Title="Lab Sample Tracker"
        Height="700"
        Width="1100"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F5"
        FontFamily="Segoe UI"
        FontSize="14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <converters:StatusBrushConverter x:Key="StatusBrushConverter"/>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#143D3A" Padding="24,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Lab Sample Tracker"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Bench list for samples waiting on the lab"
                               Margin="0,4,0,0"
                               Foreground="#D5E8E4"/>
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#1F5752"
                        CornerRadius="14"
                        Padding="12,6">
                    <TextBlock x:Name="CountText" Text="0 samples" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#E7EEEC" Padding="24,8">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Starting..." Foreground="#1C3330"/>
                <TextBlock HorizontalAlignment="Right"
                           Foreground="#5C726E"
                           Text="API  localhost:5287/api/samples"/>
            </Grid>
        </Border>

        <Grid Margin="24,16,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddButton"
                            Content="Add"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddButton_Click"
                            MouseDoubleClick="AddButton_DoubleClick"
                            Background="#FF0C9C88"/>
                    <Button x:Name="ModifyButton"
                            Content="Modify"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButton}"
                            Click="ModifyButton_Click"/>
                    <Button x:Name="DeleteButton"
                            Content="Delete"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            Style="{StaticResource DangerButton}"
                            Click="DeleteButton_Click"/>
                    <TextBlock x:Name="SelectionHint"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#5C726E"
                               Text="Check one or more rows to modify or delete"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="Refresh"
                            Margin="12,0,0,0"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Click="RefreshButton_Click"/>
                    <Button x:Name="GenerateButton"
                            Content="Generate 1,000,000"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="GenerateButton_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="SamplesGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E3EBE8"
                      AlternatingRowBackground="#F6FAF9"
                      RowBackground="White"
                      BorderBrush="#D5E0DC"
                      BorderThickness="1"
                      RowHeight="35"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D9EBE7"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#14302E"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E7F1EF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#14302E"/>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E7EEEC"/>
                        <Setter Property="Foreground" Value="#1C3330"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#D5E0DC"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Select" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Status" Width="160" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10"
                                        Padding="10,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}">
                                    <TextBlock Text="{Binding Status}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=Foreground}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox x:Name="EditorPanel"
                      Grid.Row="2"
                      Header="Add sample"
                      Visibility="Visible"
                      Margin="0,12,0,0"
                      Padding="12"
                      BorderBrush="#C5D5D1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Id" Foreground="#5C726E" Margin="0,0,12,4"/>
                    <TextBlock Grid.Column="1" Text="Name" Foreground="#5C726E" Margin="0,0,12,4"/>
                    <TextBlock Grid.Column="2" Text="Status" Foreground="#5C726E" Margin="0,0,12,4"/>

                    <TextBox x:Name="IdBox" Grid.Row="1" Margin="0,0,12,0"/>
                    <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"/>
                    <ComboBox x:Name="StatusCombo" Grid.Row="1" Grid.Column="2" Margin="0,0,12,0"/>

                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="SaveButton"
                                Content="Save"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveButton_Click"/>
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="CancelButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="EditorHint"
                               Grid.Row="2"
                               Grid.ColumnSpan="4"
                               Margin="0,8,0,0"
                               Foreground="#5C726E"
                               Text="New samples are stored by the API and added to the end of the list."/>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
